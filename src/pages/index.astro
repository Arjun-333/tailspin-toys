---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Map(
  games
    .filter((game) => game.category !== null)
    .map((game) => [game.category!.id, game.category!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  games
    .filter((game) => game.publisher !== null)
    .map((game) => [game.publisher!.id, game.publisher!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-6 flex flex-col gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
          <p class="text-sm text-slate-300" data-testid="filter-result-count" aria-live="polite">
            Showing {games.length} games
          </p>
        </div>

        <form class="grid gap-5 md:grid-cols-[1fr_16rem]">
          <fieldset>
            <legend class="mb-2 text-sm font-medium text-slate-200">Filter by category</legend>
            <div class="flex flex-wrap gap-x-5 gap-y-3">
              {categories.map((category) => (
                <label class="flex items-center gap-2 text-sm text-slate-300">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    data-testid={`category-filter-${category.id}`}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-800"
                  />
                  {category.name}
                </label>
              ))}
            </div>
          </fieldset>

          <label class="flex flex-col gap-2 text-sm font-medium text-slate-200">
            Publisher
            <select
              name="publisher"
              data-testid="publisher-filter"
              class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </label>
        </form>

        <button
          type="button"
          data-testid="clear-filters"
          class="w-fit rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
        >
          Clear filters
        </button>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => (
              <div
                data-game-card-wrapper
                data-category-id={game.category?.id ?? ''}
                data-publisher-id={game.publisher?.id ?? ''}
              >
                <GameCard game={game} />
              </div>
            ))}
          </div>
          <div class="hidden" data-testid="filter-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector('form');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-game-card-wrapper]')];
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
  const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');

  if (form && resultCount && emptyState && clearButton) {
    const categoryInputs = [...form.querySelectorAll<HTMLInputElement>('input[name="category"]')];
    const publisherInput = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

    const updateUrl = () => {
      const params = new URLSearchParams();
      categoryInputs.filter((input) => input.checked).forEach((input) => params.append('category', input.value));
      if (publisherInput?.value) {
        params.set('publisher', publisherInput.value);
      }
      const query = params.toString();
      history.replaceState(null, '', query ? `${window.location.pathname}?${query}` : window.location.pathname);
    };

    const applyFilters = (updateHistory = true) => {
      const selectedCategories = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value),
      );
      const selectedPublisher = publisherInput?.value ?? '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const categoryMatches =
          selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
        const visible = categoryMatches && publisherMatches;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      resultCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
      emptyState.classList.toggle('hidden', visibleCount !== 0);
      if (updateHistory) updateUrl();
    };

    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    categoryInputs.forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });
    if (publisherInput) publisherInput.value = params.get('publisher') ?? '';

    form.addEventListener('change', () => applyFilters());
    clearButton.addEventListener('click', () => {
      categoryInputs.forEach((input) => {
        input.checked = false;
      });
      if (publisherInput) publisherInput.value = '';
      applyFilters();
    });
    applyFilters(false);
  }
</script>
